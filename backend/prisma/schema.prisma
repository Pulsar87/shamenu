generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
  KITCHEN
}

enum OrderStatus {
  PLACED
  PREPARING
  READY
  DELIVERED
  PAID
  CANCELLED
}

model Restaurant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  timezone     String   @default("UTC")
  currency     String   @default("USD")
  logo         String?
  coverImage   String?  @map("cover_image")
  address      String?
  geo          Json?
  phone        String?
  website      String?
  hours        Json?
  settings     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  categories   Category[]
  menuItems    MenuItem[]
  tables       Table[]
  orders       Order[]
  reviews      Review[]
  loyaltyCards LoyaltyCard[]

  @@index([slug])
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  role          UserRole @default(STAFF)
  restaurantId  String?
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id])
  notifications Notification[]

  @@index([restaurantId])
}

model Category {
  id          String   @id @default(uuid())
  restaurantId String
  name        String
  sortOrder   Int      @default(0)
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  restaurant  Restaurant @relation(fields: [restaurantId], references: [id])
  menuItems   MenuItem[]

  @@index([restaurantId])
  @@index([sortOrder])
}

model MenuItem {
  id           String   @id @default(uuid())
  categoryId   String
  restaurantId String
  name         String
  description  String?
  priceCents   Int      @map("price_cents")
  imageUrl     String?  @map("image_url")
  isAvailable  Boolean  @default(true) @map("is_available")
  isFeatured   Boolean  @default(false) @map("is_featured")
  allergens    String[]
  prepTimeMin  Int?     @map("prep_time_min")
  sortOrder    Int      @default(0) @map("sort_order")
  variants     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category     Category   @relation(fields: [categoryId], references: [id])
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  orderItems   OrderItem[]

  @@index([restaurantId])
  @@index([name, description])
  @@index([categoryId])
  @@index([isAvailable])
  @@index([isFeatured])
}

model ModifierGroup {
  id        String   @id @default(uuid())
  name      String
  maxSelect Int?
  required  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options ModifierOption[]
}

model ModifierOption {
  id             String        @id @default(uuid())
  groupId        String
  name           String
  extraPriceCents Int          @map("extra_price_cents") @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  group ModifierGroup @relation(fields: [groupId], references: [id])
}

model Table {
  id           String   @id @default(uuid())
  restaurantId String
  number       String
  seats        Int?
  zone         String?
  qrToken      String   @unique @map("qr_token")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  orders     Order[]

  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@index([qrToken])
}

model Order {
  id                 String      @id @default(uuid())
  restaurantId       String
  tableId            String?
  status             OrderStatus @default(PLACED)
  items              Json
  notes              String?
  subtotalCents      Int         @map("subtotal_cents")
  taxCents           Int         @map("tax_cents") @default(0)
  tipCents           Int         @map("tip_cents") @default(0)
  totalCents         Int         @map("total_cents")
  stripePaymentIntentId String?   @map("stripe_payment_intent_id")
  placedAt           DateTime    @default(now()) @map("placed_at")
  updatedAt          DateTime    @default(now()) @map("updated_at")
  kitchenConfirmedAt DateTime?   @map("kitchen_confirmed_at")

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
  table      Table?     @relation(fields: [tableId], references: [id])
  orderItems OrderItem[]
  notifications Notification[]

  @@index([restaurantId])
  @@index([tableId])
  @@index([status])
  @@index([placedAt])
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  menuItemId          String
  quantity            Int
  modifiers           Json?
  specialInstructions String?   @map("special_instructions")
  lineTotalCents      Int      @map("line_total_cents")
  createdAt           DateTime @default(now())

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
}

model Review {
  id            String   @id @default(uuid())
  restaurantId  String
  customerName  String   @map("customer_name")
  rating        Int
  text          String?
  images        String[]
  createdAt     DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@index([createdAt])
  @@index([rating])
}

model LoyaltyCard {
  id           String   @id @default(uuid())
  customerPhone String  @map("customer_phone")
  points       Int      @default(0)
  tier         String   @default("BRONZE")
  restaurantId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([customerPhone, restaurantId])
  @@index([restaurantId])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String?
  orderId    String?
  type       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])
  order      Order?   @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@index([read])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entity     String
  entityId   String
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
